          }
        ],
        [
          {
            "node": "Registrar error envío",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Marcar recordatorio enviado": {
      "main": [
        [
          {
            "node": "Loop por cita",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Mexico_City",
