# ═══════════════════════════════════════════════════════════════════════════
# ChatbotSKC — Variables de entorno
# Copiar como .env y completar los valores reales.
# NUNCA commitear el archivo .env (está en .gitignore).
# ═══════════════════════════════════════════════════════════════════════════

# ── PostgreSQL ──────────────────────────────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=REEMPLAZAR_CON_PASSWORD
PGDATABASE=bot_citas

# ── n8n ─────────────────────────────────────────────────────────────────────
N8N_URL=https://REEMPLAZAR_CON_DOMINIO_N8N
N8N_ENCRYPTION_KEY=REEMPLAZAR_CON_KEY_ALEATORIA_32_CHARS

# ── Evolution API ────────────────────────────────────────────────────────────
EVOLUTION_HOST=https://REEMPLAZAR_CON_DOMINIO_EVOLUTION
EVOLUTION_API_KEY=REEMPLAZAR_CON_API_KEY
EVOLUTION_INSTANCE=SKC

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-REEMPLAZAR_CON_API_KEY

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=REEMPLAZAR_CON_PASSWORD

# ── Google (OAuth2 — configurar desde n8n UI, no aquí) ──────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Las credenciales OAuth2 se gestionan desde el panel de n8n Credentials.

# ── Empresa / tenant ─────────────────────────────────────────────────────────
EMPRESA_ID=REEMPLAZAR_CON_UUID_DE_EMPRESA
# Ejemplo real (si migración usó el UUID del DDL): a0000000-0000-0000-0000-000000000001
