    {
      "parameters": {
        "jsCode": "// Obtener filas de config del negocio\nconst configRows = $input.all();\nconst parts = [];\n\nfor (const row of configRows) {\n  const campo = row.json['campo'];\n  const valor = row.json['valor'];\n  if (campo && valor) {\n    parts.push(`${campo}: ${valor}`);\n  }\n}\n\nconst businessInfo = parts.join('\\n');\n\n// Recuperar datos originales del mensaje para no perderlos\nconst originalMsg = $('Filtrar fromMe').first().json;\n\nreturn [{ json: { ...originalMsg, businessInfo } }];"
      },
