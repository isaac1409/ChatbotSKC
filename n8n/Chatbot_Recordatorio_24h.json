{
  "name": "Chatbot_Recordatorio_24h",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * 1-5"
            }
          ]
        }
      },
      "id": "b1000001-feed-beef-cafe-000000000001",
      "name": "Cron 9AM Lun-Vie",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 400]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  c.id AS cita_id,\n  c.titulo,\n  c.inicio,\n  c.fin,\n  c.descripcion,\n  u.numero_whatsapp,\n  u.nombre AS nombre_usuario,\n  TO_CHAR(c.inicio AT TIME ZONE 'America/Mexico_City', 'DD/MM/YYYY') AS fecha_formato,\n  TO_CHAR(c.inicio AT TIME ZONE 'America/Mexico_City', 'HH12:MI AM') AS hora_formato\nFROM citas c\nJOIN usuarios u ON c.usuario_id = u.id\nJOIN instancias_whatsapp iw ON c.empresa_id = iw.empresa_id\nWHERE iw.evolution_instance_name = 'SKC'\n  AND c.estado IN ('pendiente', 'confirmada')\n  AND c.recordatorio_enviado = false\n  AND c.inicio BETWEEN NOW() AND NOW() + INTERVAL '25 hours'\nORDER BY c.inicio ASC",
        "options": {}
      },
      "id": "b1000002-feed-beef-cafe-000000000002",
      "name": "Obtener citas próximas",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [460, 400],
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CREDENTIAL_ID",
          "name": "PostgreSQL — ChatbotSKC"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-001",
              "leftValue": "={{ $input.all().length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "b1000003-feed-beef-cafe-000000000003",
      "name": "¿Hay citas pendientes?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 400]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "b1000004-feed-beef-cafe-000000000004",
      "name": "No hay citas",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [900, 540]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "b1000005-feed-beef-cafe-000000000005",
      "name": "Loop por cita",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [900, 320]
    },
    {
      "parameters": {
        "jsCode": "const cita = $input.first().json;\n\nconst nombreUsuario = cita.nombre_usuario || 'Cliente';\nconst fecha = cita.fecha_formato;\nconst hora = cita.hora_formato;\nconst titulo = cita.titulo || 'tu reunión';\n\nconst mensaje = `Hola ${nombreUsuario} 👋\n\nTe recordamos que tienes una cita programada:\n\n📅 *Fecha:* ${fecha}\n🕐 *Hora:* ${hora}\n📋 *Asunto:* ${titulo}\n\nSi necesitas reprogramar o cancelar, responde a este mensaje.\n\n— ZURA Solutions`;\n\nreturn [{\n  json: {\n    numero_whatsapp: cita.numero_whatsapp,\n    mensaje,\n    cita_id: cita.cita_id\n  },\n  pairedItem: { item: 0 }\n}];"
      },
      "id": "b1000006-feed-beef-cafe-000000000006",
      "name": "Formatear mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://{{ $vars.EVOLUTION_HOST }}/message/sendText/SKC",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "number",
              "value": "={{ $json.numero_whatsapp }}"
            },
            {
              "name": "text",
              "value": "={{ $json.mensaje }}"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "id": "b1000007-feed-beef-cafe-000000000007",
      "name": "Enviar recordatorio WA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 320],
      "credentials": {
        "httpHeaderAuth": {
          "id": "EVOLUTION_CREDENTIAL_ID",
          "name": "Evolution API — SKC"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=UPDATE citas SET recordatorio_enviado = true, updated_at = NOW() WHERE id = '{{ $('Formatear mensaje').first().json.cita_id }}'",
        "options": {}
      },
      "id": "b1000008-feed-beef-cafe-000000000008",
      "name": "Marcar recordatorio enviado",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1560, 320],
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CREDENTIAL_ID",
          "name": "PostgreSQL — ChatbotSKC"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO error_log (empresa_id, origen, error_code, mensaje, stack_trace)\nSELECT\n  empresa_id,\n  'recordatorio_24h',\n  'WA_SEND_FAILED',\n  'Error enviando recordatorio a ' || numero_whatsapp,\n  '{{ $json.error.message }}'\nFROM instancias_whatsapp\nWHERE evolution_instance_name = 'SKC'\nLIMIT 1",
        "options": {}
      },
      "id": "b1000009-feed-beef-cafe-000000000009",
      "name": "Registrar error envío",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1560, 500],
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CREDENTIAL_ID",
          "name": "PostgreSQL — ChatbotSKC"
        }
      }
    }
  ],
  "connections": {
    "Cron 9AM Lun-Vie": {
      "main": [
        [
          {
